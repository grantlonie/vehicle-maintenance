{
  "name": "vehicle-maintenance",
  "private": true,
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --cwd apps/api dev",
    "dev:web": "bun --cwd apps/web dev",
    "build": "bun run build:shared && bun run build:web && bun run build:api",
    "build:shared": "bun --cwd packages/shared build",
    "build:api": "bun --cwd apps/api build",
    "build:web": "bun --cwd apps/web build",
    "start": "bun --cwd apps/api start",
    "test": "bun --cwd packages/shared test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
