APP_TOKEN=change-me
PORT=3002
# Leave empty for ./data at the repo root. Use an absolute path in Docker (/data).
DATA_ROOT=
# Leave empty for local SQLite under DATA_ROOT/app.db
DATABASE_URL=
FRONTEND_DIST=
DEFAULT_DISPLAY_UNIT=km
# Gmail daily digest (optional). Use an App Password, not your login password.
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when empty
NOTIFY_TO=
# Hour (0–23 UTC) to send; default 14 ≈ 8am Mountain
NOTIFY_HOUR_UTC=14
